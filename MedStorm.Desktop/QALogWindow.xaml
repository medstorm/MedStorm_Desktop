<Window x:Class="MedStorm.Desktop.QALogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QA-log Entry"
        MinWidth="600"
        MinHeight="700"
        Width="700"
        Height="750"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        Background="#FF03303F">

    <Window.Resources>
        <!-- Brushes -->
        <SolidColorBrush x:Key="MedStormBlue" Color="#FF03303F" />
        <SolidColorBrush x:Key="MedStormAccent" Color="#c5e3ee"/>
        <SolidColorBrush x:Key="GridLineBrush" Color="#224A5E"/>
        <SolidColorBrush x:Key="RowHighlightBrush" Color="#1C3440"/>

        <!-- Style for DataGridColumnHeader -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#13313F"/>
            <Setter Property="Foreground" Value="{StaticResource MedStormAccent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#c5e3ee"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MedStormAccent}"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource MedStormAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource MedStormBlue}"/>
            <Setter Property="Foreground" Value="{StaticResource MedStormAccent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#c5e3ee"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True"
                                >
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#c5e3ee"/>
            <Setter Property="Background" Value="#122F3A"/>
            <Setter Property="BorderBrush" Value="#c5e3ee"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#13313F"/>
            <Setter Property="Background" Value="#c5e3ee"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#c5e3ee"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="RowBackground" Value="#142C38"/>
            <Setter Property="AlternatingRowBackground" Value="#18384B"/>
            <Setter Property="Background" Value="#FF03303F"/>
            <Setter Property="Foreground" Value="#c5e3ee"/>
            <Setter Property="BorderBrush" Value="#c5e3ee"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GridLineBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#123343" CornerRadius="0,0,16,16" Padding="18,16,18,10">
            <StackPanel>
                <TextBlock Text="Quality Assurance Log Entry" FontSize="22" FontWeight="Bold" Foreground="#c5e3ee"/>
                <TextBlock Text="Please record all relevant QA information for this session." 
                           FontSize="14" Margin="0,3,0,0" Foreground="#8dc8dd"/>
            </StackPanel>
        </Border>

        <!-- Spacer -->
        <Rectangle Grid.Row="1" Height="14" Fill="Transparent"/>

        <!-- Intervention -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="28,0,18,3">
            <Label Content="Intervention:" VerticalAlignment="Center" Width="120"/>
            <ComboBox x:Name="InterventionBox"
                      Width="350"
                      IsEditable="True"
                      ItemsSource="{Binding Interventions}"
                      Text="{Binding SelectedIntervention, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- Input Parameters -->
        <Label Grid.Row="3" Content="Input Parameters:" Margin="28,6,0,2"/>
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding InputEntries}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  HeadersVisibility="Column"
                  Margin="170,6,18,0"
                  IsReadOnly="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Parameter" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Parameter}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True"
                                ItemsSource="{Binding DataContext.AvailableParameters, RelativeSource={RelativeSource AncestorType=Window}}"
                                Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Value"
                            Binding="{Binding Value, Mode=TwoWay}"
                            Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Outcome Parameters -->
        <Label Grid.Row="4" Content="Outcome Parameters:" Margin="28,6,0,2"/>
        <DataGrid Grid.Row="5"
                  ItemsSource="{Binding OutcomeEntries}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  HeadersVisibility="Column"
                  Margin="170,6,18,0"
                  IsReadOnly="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Parameter" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Parameter}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True"
                                ItemsSource="{Binding DataContext.AvailableParameters, RelativeSource={RelativeSource AncestorType=Window}}"
                                Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Value"
                            Binding="{Binding Value, Mode=TwoWay}"
                            Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Comments -->
        <Label Grid.Row="6" Content="Comments:" Margin="28,12,0,4"/>
        <TextBox x:Name="CommentsBox" Grid.Row="7"
             Margin="28,0,18,0"
             VerticalScrollBarVisibility="Auto"
             Height="74"
             TextWrapping="Wrap"
             AcceptsReturn="True"
             FontSize="15"
             BorderThickness="1.5"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,24,8">
            <Button Content="Cancel" Width="110" Click="Cancel_Click"/>
            <Button Content="Send to EMR" Width="145" Click="Send_Click"/>
        </StackPanel>
    </Grid>
</Window>
