<Window x:Class="MedStorm.Desktop.QALogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QA Log Entry"
        MinWidth="900" MinHeight="600"
        Width="1150" Height="700"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#B1C9D1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#D1E6EE" Padding="28,18,24,14" CornerRadius="0,0,18,18">
            <DockPanel>
                <!-- Back Button, small and clean -->
                <Button Width="38" Height="38" Margin="0,0,15,0"
                        Padding="0" Background="Transparent" BorderBrush="Transparent"
                        Click="Back_Click">
                    <Path Data="M12,2 L2,12 L12,22" Stroke="#284859" StrokeThickness="2.8" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                </Button>
                <TextBlock Text="QA Log: Please fill in the intervention and all parameters as appropriate"
                           FontSize="22" FontWeight="SemiBold" Foreground="#284859" 
                           Margin="6,2,0,0"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Main content: Scrollable -->
        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Margin="36,0,36,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Intervention -->
                <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,20">
                    <TextBlock Text="Intervention:" FontWeight="Bold" FontSize="19" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="InterventionBox"
                              ItemsSource="{Binding Interventions}" 
                              SelectedItem="{Binding SelectedIntervention, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FontSize="18"
                              MinWidth="320" Height="38"
                              IsEditable="False"
                              VerticalAlignment="Center"
                              />
                </StackPanel>

                <!-- Input Parameters -->
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,18,0">
                    <TextBlock Text="Input Parameters" FontWeight="Bold" FontSize="20" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding InputParameterValues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                                    <TextBlock Text="{Binding Name}" FontSize="17" Width="215" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="17" Width="80" Height="28" VerticalContentAlignment="Center"
                                             Margin="0,0,0,0"
                                             HorizontalContentAlignment="Right"
                                             PreviewTextInput="NumberOnly_PreviewTextInput"
                                             MaxLength="9"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Spacer -->
                <Rectangle Grid.Column="1" Grid.RowSpan="2" Fill="Transparent" Width="36"/>

                <!-- Outcome Parameters -->
                <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,0">
                    <TextBlock Text="Outcome Parameters" FontWeight="Bold" FontSize="20" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding OutcomeParameterValues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                                    <TextBlock Text="{Binding Name}" FontSize="17" Width="235" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="17" Width="80" Height="28" VerticalContentAlignment="Center"
                                             Margin="0,0,0,0"
                                             HorizontalContentAlignment="Right"
                                             PreviewTextInput="NumberOnly_PreviewTextInput"
                                             MaxLength="9"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,26,10">
            <Button Content="Cancel" Width="125" Height="44" Margin="0,0,20,0" Click="Cancel_Click" FontSize="17"/>
            <Button Content="Save / Send to EMR" Width="185" Height="44" Click="Send_Click" FontSize="17" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
