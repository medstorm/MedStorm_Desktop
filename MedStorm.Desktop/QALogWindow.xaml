<Window x:Class="MedStorm.Desktop.QALogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MedStorm.Desktop"
        Title="QA Log Entry"
        MinWidth="900" MinHeight="600"
        Width="1100" Height="730"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#B1C9D1">
    <Window.Resources>
        <DataTemplate x:Key="NumericParameterTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,10" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" 
                           FontSize="20" Width="320" Margin="0,0,14,0" 
                           VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{Binding Name}"/>
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="20" Width="115" Height="42" VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Right"
                         PreviewTextInput="NumberOnly_PreviewTextInput"
                         DataObject.Pasting="NumberOnly_Pasting"
                         KeyDown="TextBox_KeyDown"
                         Margin="0,0,0,0"
                         MaxLength="9"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="DrugParameterTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,10" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" 
                           FontSize="20" Width="320" Margin="0,0,14,0" 
                           VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{Binding Name}"/>
                <ComboBox ItemsSource="{Binding DrugOptions}"
                          SelectedItem="{Binding SelectedDrug, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          FontSize="20" Width="160" Height="42"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="20" Width="90" Height="42" VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Right"
                         PreviewTextInput="NumberOnly_PreviewTextInput"
                         DataObject.Pasting="NumberOnly_Pasting"
                         KeyDown="TextBox_KeyDown"
                         Margin="0,0,0,0"
                         MaxLength="9"/>
            </StackPanel>
        </DataTemplate>
        <local:ParamValueTemplateSelector x:Key="ParamTemplateSelector"
            NumericParameterTemplate="{StaticResource NumericParameterTemplate}"
            DrugParameterTemplate="{StaticResource DrugParameterTemplate}" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#D1E6EE" Padding="26,20,24,20" CornerRadius="0,0,18,18">
            <DockPanel LastChildFill="True">
                <!-- Back Button, small and clean -->
                <Button Width="42" Height="42" Margin="0,0,18,0"
                        Padding="0" Background="Transparent" BorderBrush="Transparent"
                        Click="Back_Click">
                    <Path Data="M12,2 L2,12 L12,22" Stroke="#284859" StrokeThickness="3" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                </Button>
                <TextBlock Text="{Binding Header}"
                           FontSize="26" FontWeight="SemiBold" Foreground="#284859" 
                           Margin="10,2,0,0"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Main content: Scrollable -->
        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Margin="26,0,26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4.2*"/>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="4.2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Intervention -->
                <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,20">
                    <TextBlock Text="Intervention:" FontWeight="Bold" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="InterventionBox"
                              ItemsSource="{Binding Interventions}" 
                              SelectedItem="{Binding SelectedIntervention, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FontSize="21"
                              MinWidth="260" Height="42"
                              IsEditable="False"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Input Parameters -->
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,8,0">
                    <TextBlock Text="Input Parameters" FontWeight="Bold" FontSize="23" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding InputParameterValues}"
                                  ItemTemplateSelector="{StaticResource ParamTemplateSelector}"/>
                </StackPanel>

                <!-- Spacer -->
                <Rectangle Grid.Column="1" Grid.RowSpan="2" Fill="Transparent" Width="20"/>

                <!-- Outcome Parameters -->
                <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,0">
                    <TextBlock Text="Outcome Parameters" FontWeight="Bold" FontSize="23" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding OutcomeParameterValues}"
                                  ItemTemplateSelector="{StaticResource ParamTemplateSelector}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,32,18">
            <Button Content="Cancel" Width="145" Height="48" Margin="0,0,24,0" Click="Cancel_Click" FontSize="19"/>
            <Button Content="Save / Send to EMR" Width="215" Height="48" Click="Send_Click" FontSize="19" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
