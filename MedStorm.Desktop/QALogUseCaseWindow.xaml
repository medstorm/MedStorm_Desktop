<Window x:Class="MedStorm.Desktop.QALogUseCaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QA Log Use Case"
        MinWidth="600" MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#B1C9D1">
    <Grid>
        <!-- Header -->
        <Border Background="#D1E6EE" Height="88" VerticalAlignment="Top" CornerRadius="0,0,32,32">
            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                <Button Width="44" Height="44" Click="Cancel_Click"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        ToolTip="Back" Margin="18,0,0,0"
                        VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Path Data="M13,22 L3,12 L13,2" Stroke="#284859" StrokeThickness="3"
                          StrokeLineJoin="Round" StrokeEndLineCap="Round"/>
                </Button>
                <TextBlock Text="Select QA Log Use Case"
                           FontSize="30" FontWeight="Bold" Foreground="#284859"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Margin="0,0,0,0"
                           TextAlignment="Center" />
            </DockPanel>
        </Border>
        <!-- Centered buttons, bigger, material style -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0" Width="550" >
            <Button Content="Preterm Infants"
                    Tag="PretermInfants" Click="UseCase_Click"
                    FontSize="24" Padding="0"
                    Background="#CDE2F1" Foreground="#284859" BorderThickness="0"
                    HorizontalContentAlignment="Center" FontWeight="Bold"
                    Margin="0,0,0,28"
                    Cursor="Hand" Height="94">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                BorderBrush="#B1C9D1" BorderThickness="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9BCDEB"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" Opacity="0.19" Color="#284859"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7EB5D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="ICU"
                    Tag="ICU" Click="UseCase_Click"
                    FontSize="24" Padding="0"
                    Background="#CDE2F1" Foreground="#284859" BorderThickness="0"
                    HorizontalContentAlignment="Center" FontWeight="Bold"
                    Margin="0,0,0,28"
                    Cursor="Hand" Height="94">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                BorderBrush="#B1C9D1" BorderThickness="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9BCDEB"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" Opacity="0.19" Color="#284859"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7EB5D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Operating Theatre"
                    Tag="OperatingTheatre" Click="UseCase_Click"
                    FontSize="24" Padding="0"
                    Background="#CDE2F1" Foreground="#284859" BorderThickness="0"
                    HorizontalContentAlignment="Center" FontWeight="Bold"
                    Margin="0"
                    Cursor="Hand" Height="94">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                BorderBrush="#B1C9D1" BorderThickness="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9BCDEB"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" Opacity="0.19" Color="#284859"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7EB5D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
