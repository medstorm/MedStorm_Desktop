<Window x:Class="MedStorm.Desktop.QALogUseCaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select QA Log Use Case"
        Width="600" Height="400"
        MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#E1EDF2">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
         <!--Title and Back--> 
        <DockPanel VerticalAlignment="Center" Grid.Row="0" LastChildFill="True">
            <Button Content="⟵" 
                    Width="46" Height="38" 
                    Margin="10,8,0,8"
                    VerticalAlignment="Center"
                    FontSize="22"
                    Background="#D8E6EC"
                    Click="Cancel_Click"/>
            <TextBlock Text="Select QA Log Use Case"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="#1C425A"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"/>
        </DockPanel>
         <!--Use case buttons--> 
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,18">
            <Button Content="Preterm Infants (Postop, Opioids)" Tag="PretermInfants" Width="360" Height="48" FontSize="18" Click="UseCase_Click" Margin="0,0,0,8"/>
            <Button Content="ICU Patients (Postop, Opioids)" Tag="ICU" Width="360" Height="48" FontSize="18" Click="UseCase_Click" Margin="0,0,0,8"/>
            <Button Content="Surgery / Operating Theatre (Opioids)" Tag="OperatingTheatre" Width="360" Height="48" FontSize="18" Click="UseCase_Click" Margin="0,0,0,8"/>
        </StackPanel>
    </Grid>
</Window>

